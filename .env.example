# ============================================================================
# Teman Kost — contoh konfigurasi environment
# Copy ke `.env` lalu isi nilainya. JANGAN commit `.env`.
# ============================================================================

# --- Database (Neon Postgres) -------------------------------------------------
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Auth (NextAuth) ----------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Untuk Google OAuth (opsional kalau hanya pakai credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- AI (Google Gemini) -------------------------------------------------------
# API key server default. Dipakai kalau user tidak menyimpan key pribadi.
GEMINI_API_KEY=

# --- Mesin AI (M2.2) ----------------------------------------------------------
# Nama model per jenis tugas. Default = gemini-3.6-flash (perilaku lama).
#AI_MODEL_CHAT=gemini-3.6-flash
#AI_MODEL_DIALOGUE=gemini-3.6-flash
# Model cadangan kalau model utama gagal (429/5xx/timeout). Biarkan kosong
# kalau tidak yakin nama modelnya benar — model yang salah hanya buang waktu.
#AI_MODEL_FALLBACK=
#AI_TIMEOUT_MS=25000
#AI_MAX_RETRIES=2
# Jeda dasar backoff antar percobaan (ms). Naik 2x tiap percobaan. Default 1000.
#AI_RETRY_BASE_MS=1000
# Circuit breaker: buka setelah N request gagal beruntun, coba lagi setelah cooldown.
#AI_BREAKER_FAILURE_THRESHOLD=5
#AI_BREAKER_COOLDOWN_MS=60000

# --- Enkripsi secret user (WAJIB untuk fitur API key pribadi) -----------------
# Dipakai untuk enkripsi AES-256-GCM API key Gemini milik user.
# HARUS 32 byte setelah di-decode base64.
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
#
# PERINGATAN:
#  - Kalau nilai ini hilang/berubah, semua API key user yang tersimpan TIDAK
#    bisa didekripsi lagi (user harus memasukkan ulang key-nya).
#  - Simpan di secret manager (Vercel Env / 1Password / dll), bukan di repo.
#  - Rotasi butuh migrasi: dekripsi dengan kunci lama, enkripsi ulang dengan
#    kunci baru (lihat docs/M0-IMPLEMENTATION.md).
ENCRYPTION_KEY=

# --- Text-to-Speech (ElevenLabs) ---------------------------------------------
# WAJIB untuk fitur suara (M6.1): tanpa keduanya /api/tts gagal 500.
# ELEVENLABS_VOICE_ID = ID voice kamu di console.elevenlabs.io (Voice Library).
# Tidak ada fallback default — kalau kosong, TTS mati total.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# OPSIONAL (M6.4): cap karakter/hari per user yang di-billing ke ElevenLabs.
# Pengaman biaya di atas rate limit request (200/hari, 300 char/request).
# Default 30000 kalau kosong — naikkan kalau plan ElevenLabs kamu besar.
# TTS_MAX_CHARS_PER_DAY=30000

# --- Pemakaian & biaya AI (M7.1) --------------------------------------------
# Email owner — satu-satunya yang boleh membuka dashboard /usage & /api/usage.
# Kalau kosong, dashboard terkunci untuk SEMUA orang (default aman).
# OWNER_EMAIL=
# Cap biaya AI per hari (USD, semua user) sebelum alert `ai.budget_alert`
# muncul di log. Default 5 kalau kosong.
# AI_DAILY_COST_LIMIT_USD=5

# --- Uptime & alerting (M7.5) -------------------------------------------------
# Webhook Discord (Server → Integrations → Webhooks → New Webhook) atau
# Slack (API → Incoming Webhooks). Format payload dideteksi otomatis dari URL.
# Kalau kosong: tidak ada webhook yang dikirim — aplikasi tetap jalan normal,
# alert budget & error-rate hanya masuk log.
# ALERT_WEBHOOK_URL=
# Jumlah error 5xx dalam 5 menit sebelum webhook "lonjakan error" menyala.
# Default 10 kalau kosong.
# ALERT_5XX_THRESHOLD=10
#
# Endpoint untuk monitor uptime (UptimeRobot/Better Stack):
#   https://livia.qzz.io/api/health  (cek DB, 200 = sehat, 503 = DB down)
