{
  "extends": "next/core-web-vitals",
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-throw-literal": "error",
    "no-debugger": "error",

    "react/no-unescaped-entities": [
      "warn",
      {
        "forbid": [">", "}"]
      }
    ],

    "@typescript-eslint/no-explicit-any": "warn"
  }
}
